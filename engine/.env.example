# Supabase (Settings -> API). The service-role key bypasses RLS: keep it secret.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional default Google Places API key (workspaces can set their own in Settings -> Integrations)
GOOGLE_PLACES_API_KEY=

# Allow the headless-browser Google Maps scraper (needs Chromium; the Docker image includes it)
SCRAPER_BROWSER=true

# info | debug | warn
LOG_LEVEL=info

# Optional: expose /health on this port (only needed when running as a Render *web* service)
PORT=
